---
// A static copy of the app's usage row (UsageBar, PeriodPips, BorrowAhead),
// read like a battery. Left to right: banked time as one green pip per day
// it could fill, today's budget as one full-width indigo bar that turns grey
// from the right as it goes (first to paying back borrowing, then to use),
// then one pip per day ahead that can be borrowed from, filled in rust by
// how much is taken. Decorative: the text around it says the same.

interface Props {
  // Each 0 to 1: how full each banked pip is.
  banked?: number[];
  // Minutes. Today's budget, and how much of it went to paying back
  // borrowing and to use.
  budget: number;
  used?: number;
  repaid?: number;
  // Each 0 to 1: how much of each day ahead is already borrowed.
  ahead?: number[];
}

const { banked = [], budget, used = 0, repaid = 0, ahead = [] } = Astro.props;

const clamp = (value: number) => Math.min(Math.max(value, 0), 1);
const spent = budget > 0 ? clamp((repaid + used) / budget) : 1;
---

<div class="usage" aria-hidden="true">
  {
    banked.length > 0 && (
      <span class="pips">
        {banked.map((fill) => (
          <span class:list={["pip", "banked", { filled: fill > 0 }]} style={`--fill: ${clamp(fill)}`}>
            <span class="fill" />
          </span>
        ))}
      </span>
    )
  }
  <span class="bar" style={`--spent: ${spent}`}>
    <span class="spent" />
  </span>
  {
    ahead.length > 0 && (
      <span class="pips">
        {ahead.map((fill) => (
          <span class:list={["pip", "borrowed", { filled: fill > 0 }]} style={`--fill: ${clamp(fill)}`}>
            <span class="fill" />
          </span>
        ))}
      </span>
    )
  }
</div>

<style>
  .usage {
    --bar-height: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pips {
    display: flex;
    gap: 4px;
  }

  .pip {
    display: block;
    width: 22px;
    height: var(--bar-height);
    border: 1.5px solid var(--color-outline);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .pip .fill {
    display: block;
    width: calc(var(--fill) * 100%);
    height: 100%;
  }

  .banked.filled {
    border-color: var(--color-banked);
  }

  .banked .fill {
    background: var(--color-banked);
  }

  .borrowed.filled {
    border-color: var(--color-borrowed);
  }

  .borrowed .fill {
    background: var(--color-borrowed);
  }

  .bar {
    display: flex;
    flex: 1;
    justify-content: flex-end;
    min-width: 0;
    height: var(--bar-height);
    border-radius: var(--radius-full);
    overflow: hidden;
    background: var(--color-primary);
  }

  .spent {
    display: block;
    width: calc(var(--spent) * 100%);
    height: 100%;
    background: var(--color-outline-variant);
  }
</style>
