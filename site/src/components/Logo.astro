---
import { markShapes, nextClipId } from "../brand/mark";

interface Props {
  size?: number;
  // Names the mark for screen readers. Leave it out when a visible
  // "Roolio" sits next to it.
  label?: string;
  class?: string;
}

const { size = 32, label, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 96 96"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={markShapes(nextClipId())}
/>
