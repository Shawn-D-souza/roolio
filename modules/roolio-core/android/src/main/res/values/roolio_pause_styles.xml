<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The pause screen's buttons: full width, at least 48dp to touch, text as written. -->
    <style name="RoolioPauseButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/roolio_pause_button_height</item>
        <item name="android:paddingStart">@dimen/roolio_pause_gutter</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">@dimen/roolio_pause_gutter</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
