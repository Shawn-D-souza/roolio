<?xml version="1.0" encoding="utf-8"?>
<!--
  The pause screen: a card near the bottom of the dimmed home
  screen. It's inflated into the window's root, which draws the dim and
  takes taps outside the card. The card scrolls, so it fits in landscape and
  at large font sizes.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roolio_pause_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_margin="@dimen/roolio_pause_card_margin"
    android:background="@drawable/roolio_pause_card"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/roolio_pause_card_padding"
        android:paddingTop="@dimen/roolio_pause_card_padding"
        android:paddingEnd="@dimen/roolio_pause_card_padding"
        android:paddingBottom="@dimen/roolio_pause_card_padding">

        <!-- Who's speaking: Roolio, not the paused app. -->
        <LinearLayout
            android:id="@+id/roolio_pause_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/roolio_pause_brand_icon"
                android:layout_width="@dimen/roolio_pause_brand_icon_size"
                android:layout_height="@dimen/roolio_pause_brand_icon_size"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/roolio_pause_brand_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/roolio_pause_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Decorative: the body names the app. -->
        <ImageView
            android:id="@+id/roolio_pause_icon"
            android:layout_width="@dimen/roolio_pause_icon_size"
            android:layout_height="@dimen/roolio_pause_icon_size"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/roolio_pause_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/roolio_pause_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/roolio_pause_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/roolio_pause_on_surface_variant"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/roolio_pause_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/roolio_pause_on_surface_variant"
            android:textSize="14sp"
            android:visibility="gone" />

        <!--
          Choices from quietest to strongest: borrowing a period, a little more,
          then stop. Stopping sits at the bottom, nearest the thumb, so a stray
          tap as the card appears lands on the safe choice. The optional choices
          carry the gap below them, so the spacing holds when they're hidden.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/roolio_pause_use_period"
                style="@style/RoolioPauseButton"
                android:layout_marginBottom="8dp"
                android:background="@drawable/roolio_pause_button_text"
                android:textColor="@color/roolio_pause_primary"
                android:visibility="gone" />

            <Button
                android:id="@+id/roolio_pause_extra"
                style="@style/RoolioPauseButton"
                android:layout_marginBottom="8dp"
                android:background="@drawable/roolio_pause_button_tonal"
                android:textColor="@color/roolio_pause_on_surface"
                android:visibility="gone" />

            <Button
                android:id="@+id/roolio_pause_close"
                style="@style/RoolioPauseButton"
                android:background="@drawable/roolio_pause_button_filled"
                android:text="@string/roolio_pause_close"
                android:textColor="@color/roolio_pause_on_primary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
